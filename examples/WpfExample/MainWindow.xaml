<Window x:Class="WpfExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAK Modbus 테스터" Height="700" Width="900"
        Closing="Window_Closing">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 연결 설정 ── -->
        <GroupBox Grid.Row="0" Header="연결 설정" Margin="0,0,0,5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="3">
                    <RadioButton x:Name="RbTcp" Content="TCP" IsChecked="True"
                                 Checked="ConnectionType_Changed" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbRtu" Content="RTU"
                                 Checked="ConnectionType_Changed" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- TCP 설정 -->
                <StackPanel x:Name="PnlTcp" Orientation="Horizontal">
                    <Label Content="IP 주소:"/>
                    <TextBox x:Name="TxtHost" Width="150" Text="192.168.1.1"/>
                    <Label Content="포트:"/>
                    <TextBox x:Name="TxtPort" Width="60" Text="502"/>
                    <Label Content="타임아웃(ms):"/>
                    <TextBox x:Name="TxtTcpTimeout" Width="70" Text="3000"/>
                </StackPanel>

                <!-- RTU 설정 -->
                <StackPanel x:Name="PnlRtu" Orientation="Horizontal" Visibility="Collapsed">
                    <Label Content="포트:"/>
                    <ComboBox x:Name="CmbPort" Width="100" Margin="3"/>
                    <Label Content="Baud Rate:"/>
                    <ComboBox x:Name="CmbBaud" Width="80" Margin="3"
                              ItemsSource="{Binding BaudRates}" SelectedValue="9600"/>
                    <Label Content="Parity:"/>
                    <ComboBox x:Name="CmbParity" Width="70" Margin="3">
                        <ComboBoxItem Content="None" IsSelected="True"/>
                        <ComboBoxItem Content="Even"/>
                        <ComboBoxItem Content="Odd"/>
                    </ComboBox>
                    <Label Content="Stop Bits:"/>
                    <ComboBox x:Name="CmbStopBits" Width="60" Margin="3">
                        <ComboBoxItem Content="1" IsSelected="True"/>
                        <ComboBoxItem Content="2"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="3">
                    <Button x:Name="BtnConnect" Content="연결" Click="BtnConnect_Click" Width="80"/>
                    <Button x:Name="BtnDisconnect" Content="해제" Click="BtnDisconnect_Click"
                            Width="80" IsEnabled="False"/>
                    <Ellipse x:Name="EllStatus" Width="14" Height="14" Fill="Gray"
                             Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Label x:Name="LblStatus" Content="미연결" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ── Read 설정 ── -->
        <GroupBox Grid.Row="1" Header="읽기 (Read)" Margin="0,0,0,5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="3">
                    <Label Content="Device ID:"/>
                    <TextBox x:Name="TxtReadDeviceId" Width="50" Text="1"/>
                    <Label Content="시작 주소:"/>
                    <TextBox x:Name="TxtReadAddress" Width="70" Text="0"/>
                    <Label Content="개수:"/>
                    <TextBox x:Name="TxtReadCount" Width="50" Text="10"/>
                    <Label Content="Function:"/>
                    <ComboBox x:Name="CmbReadFc" Width="180" Margin="3">
                        <ComboBoxItem Content="FC03 - Holding Register" IsSelected="True" Tag="03"/>
                        <ComboBoxItem Content="FC04 - Input Register" Tag="04"/>
                        <ComboBoxItem Content="FC01 - Coil" Tag="01"/>
                        <ComboBoxItem Content="FC02 - Discrete Input" Tag="02"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="3">
                    <Button x:Name="BtnReadOnce" Content="단발성 읽기" Click="BtnReadOnce_Click" Width="110"/>
                    <Button x:Name="BtnStartPolling" Content="실시간 읽기 시작" Click="BtnStartPolling_Click" Width="130"/>
                    <Button x:Name="BtnStopPolling" Content="중지" Click="BtnStopPolling_Click"
                            Width="70" IsEnabled="False"/>
                    <Label Content="주기(ms):"/>
                    <TextBox x:Name="TxtPollInterval" Width="70" Text="500"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ── Write 설정 ── -->
        <GroupBox Grid.Row="2" Header="쓰기 (Write)" Margin="0,0,0,5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="3">
                    <Label Content="Device ID:"/>
                    <TextBox x:Name="TxtWriteDeviceId" Width="50" Text="1"/>
                    <Label Content="시작 주소:"/>
                    <TextBox x:Name="TxtWriteAddress" Width="70" Text="0"/>
                    <Label Content="값 (쉼표 구분):"/>
                    <TextBox x:Name="TxtWriteValues" Width="200" Text="1234"/>
                    <CheckBox x:Name="ChkWriteReadBack" Content="쓰기 후 읽기"
                              VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="3">
                    <Button x:Name="BtnWriteOnce" Content="단발성 쓰기" Click="BtnWriteOnce_Click" Width="110"/>
                    <Button x:Name="BtnStartPeriodicWrite" Content="주기적 쓰기 시작" Click="BtnStartPeriodicWrite_Click" Width="130"/>
                    <Button x:Name="BtnStopPeriodicWrite" Content="중지" Click="BtnStopPeriodicWrite_Click"
                            Width="70" IsEnabled="False"/>
                    <Label Content="주기(ms):"/>
                    <TextBox x:Name="TxtWriteInterval" Width="70" Text="1000"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ── 결과 헤더 ── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,3">
            <Label Content="결과 로그" FontWeight="Bold"/>
            <Button Content="지우기" Click="BtnClearLog_Click" Padding="8,2" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- ── 결과 로그 ── -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                      x:Name="ScrollLog">
            <TextBox x:Name="TxtLog"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     VerticalAlignment="Stretch"
                     AcceptsReturn="True"
                     Background="#F8F8F8"/>
        </ScrollViewer>
    </Grid>
</Window>
