<Window x:Class="SimulatorWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAK Modbus 시뮬레이터 (슬레이브)" Height="700" Width="960"
        Closing="Window_Closing">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- 서버 제어 -->
        <GroupBox Grid.Row="0" Header="서버 설정" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Margin="4">
                <Label Content="포트:"/>
                <TextBox x:Name="TxtPort" Width="70" Text="5020" Margin="2,2,10,2" Padding="4,2"/>
                <Button x:Name="BtnStart" Content="▶ 시작" Width="80" Margin="2"
                        Click="BtnStart_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="6,4"/>
                <Button x:Name="BtnStop" Content="■ 중지" Width="80" Margin="2"
                        Click="BtnStop_Click" IsEnabled="False" Background="#F44336" Foreground="White" FontWeight="Bold" Padding="6,4"/>
                <Ellipse x:Name="EllStatus" Width="14" Height="14" Fill="Gray" Margin="12,0,4,0" VerticalAlignment="Center"/>
                <Label x:Name="LblStatus" Content="중지됨" VerticalAlignment="Center" FontWeight="Bold"/>
                <Label x:Name="LblClients" Content="연결: 0개" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="Gray"/>
            </StackPanel>
        </GroupBox>

        <!-- 레지스터 수동 설정 -->
        <GroupBox Grid.Row="1" Header="레지스터/코일 수동 설정" Margin="0,0,0,4">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="종류:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="CmbMemType" Width="160" Margin="2" VerticalAlignment="Center">
                    <ComboBoxItem Content="Holding Register (4x)" IsSelected="True"/>
                    <ComboBoxItem Content="Input Register (3x)"/>
                    <ComboBoxItem Content="Coil (0x)"/>
                    <ComboBoxItem Content="Discrete Input (1x)"/>
                </ComboBox>
                <Label Grid.Column="2" Content="주소:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" x:Name="TxtSetAddr" Width="70" Text="0" Margin="2" Padding="4,2"/>
                <Label Grid.Column="4" Content="값:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" x:Name="TxtSetValue" Width="100" Text="1234" Margin="2" Padding="4,2"/>
                <Button Grid.Column="6" Content="설정" Click="BtnSetValue_Click"
                        Width="70" Margin="4,2" Padding="6,4" Background="#2196F3" Foreground="White"/>
                <Button Grid.Column="7" Content="자동 카운터 (1초마다 +1)" Click="BtnAutoIncrement_Click"
                        Margin="4,2" Padding="6,4" HorizontalAlignment="Left"/>
            </Grid>
        </GroupBox>

        <!-- 탭: Holding Register / Coil -->
        <TabControl Grid.Row="2" Margin="0,0,0,4">

            <!-- Holding Register 탭 -->
            <TabItem Header="Holding Register (4x)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4,4,4,2">
                        <Label Content="표시 시작 주소:"/>
                        <TextBox x:Name="TxtHrStart" Width="70" Text="0" Margin="2" Padding="4,2"/>
                        <Label Content="개수:"/>
                        <TextBox x:Name="TxtHrCount" Width="60" Text="20" Margin="2" Padding="4,2"/>
                        <Button Content="새로고침" Click="BtnRefreshHr_Click" Margin="4,2" Padding="6,4"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="DgHoldingReg"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F5F5F5"
                              Margin="4,0,4,4" FontFamily="Consolas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="주소"    Binding="{Binding Address}" Width="80"/>
                            <DataGridTextColumn Header="값 (Dec)" Binding="{Binding ValueDec}" Width="100"/>
                            <DataGridTextColumn Header="값 (Hex)" Binding="{Binding ValueHex}" Width="100"/>
                            <DataGridTextColumn Header="값 (Bin)" Binding="{Binding ValueBin}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Coil 탭 -->
            <TabItem Header="Coil (0x)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4,4,4,2">
                        <Label Content="표시 시작 주소:"/>
                        <TextBox x:Name="TxtCoilStart" Width="70" Text="0" Margin="2" Padding="4,2"/>
                        <Label Content="개수:"/>
                        <TextBox x:Name="TxtCoilCount" Width="60" Text="16" Margin="2" Padding="4,2"/>
                        <Button Content="새로고침" Click="BtnRefreshCoil_Click" Margin="4,2" Padding="6,4"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="DgCoils"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F5F5F5"
                              Margin="4,0,4,4" FontFamily="Consolas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="주소" Binding="{Binding Address}" Width="80"/>
                            <DataGridTextColumn Header="상태" Binding="{Binding State}"   Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- 로그 헤더 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,2">
            <Label Content="요청 로그" FontWeight="Bold"/>
            <Button Content="지우기" Click="BtnClearLog_Click" Padding="6,2" Margin="10,0,0,0"/>
            <CheckBox x:Name="ChkAutoScroll" Content="자동 스크롤" IsChecked="True"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 요청 로그 -->
        <ScrollViewer Grid.Row="4" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     AcceptsReturn="True" TextWrapping="NoWrap" Background="#1E1E1E" Foreground="#D4D4D4"/>
        </ScrollViewer>
    </Grid>
</Window>
